# Caddy reverse proxy.
#
# NOTE: For DuckDNS domains we serve plain HTTP because DuckDNS nameservers
# are too slow for Let's Encrypt validation (DNS lookups time out from
# LE's secondary validators).  Once you move to a real domain (e.g. a
# Namecheap $10/year .dev), change `http://{$DOMAIN}` back to `{$DOMAIN}`
# and Caddy will provision HTTPS automatically.
#
# Routing:
#   /api/*  → FastAPI backend container (port 8000)
#   /*      → Next.js frontend container (port 3000)

http://{$DOMAIN} {
    encode zstd gzip

    # Hide API docs in production — don't advertise the full API surface.
    # (To temporarily re-enable for debugging, remove this stanza and
    # restart caddy: docker compose restart caddy)
    @docs path /docs /openapi.json /redoc
    respond @docs 404

    # Backend API
    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }

    # Frontend (Next.js, catches everything else)
    handle {
        reverse_proxy frontend:3000
    }

    # Sensible request size limit (resume upload max ~10MB)
    request_body {
        max_size 10MB
    }

    # Security headers (HSTS removed because we're on HTTP for now)
    header {
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    # Access log
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
