# Caddy reverse proxy.
#
# Plain HTTP serving — Caddy's auto-HTTPS provisioning needs Let's Encrypt
# to reach this server on port 80 for the HTTP-01 challenge, and even that
# occasionally hangs on first boot.  HTTP keeps the deploy bulletproof.
# When you move to a real domain, switch the site-block back to `{$DOMAIN}`
# (no `http://` prefix) and Caddy will provision HTTPS automatically.
#
# Routing:
#   /api/*  → FastAPI backend container (port 8000)
#   /*      → Next.js frontend container (port 3000)

http://{$DOMAIN} {
    encode zstd gzip

    # Hide API docs in production — don't advertise the full API surface.
    @docs path /docs /openapi.json /redoc
    respond @docs 404

    # Backend API
    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }

    # Frontend (Next.js, catches everything else)
    handle {
        reverse_proxy frontend:3000
    }

    # Sensible request size limit (resume upload max ~10MB)
    request_body {
        max_size 10MB
    }

    # Security headers (HSTS removed because we're on HTTP for now)
    header {
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    # Access log
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
