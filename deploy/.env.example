# ─────────────────────────────────────────────────────────────────────────────
# JobJarvis production environment.  COPY THIS FILE TO `.env` and fill in.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Your domain (must point to the VM's external IP via DNS A record).
# Caddy uses this to issue a Let's Encrypt cert.
DOMAIN=jobjarvis.example.com

# Generate with:  openssl rand -hex 32
SECRET_KEY=REPLACE_ME_WITH_openssl_rand_hex_32

# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_ME_WITH_openssl_rand_hex_24

# AI features (cover letters, resume tailoring) require ONE of these.
# Anthropic preferred for long-form writing. OpenAI is cheaper.
# Without either, AI features fall back to a template stub.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Real-time match alerts → Slack (single webhook for all alerts)
SLACK_WEBHOOK_URL=

# Daily AI budget cap in USD (kill-switch for runaway costs).
AI_DAILY_BUDGET_USD=2.0

# Token lifetime — bump up for production so users don't get logged out daily.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

LOG_LEVEL=INFO

# Comma-separated extra origins for CORS (in addition to https://${DOMAIN}).
# Leave blank if you only serve from DOMAIN.
CORS_ALLOWED_ORIGINS=

# Database backup retention — number of daily dumps to keep in /app/backups
BACKUP_RETENTION=7

# Optional SMTP — only if you want daily digest emails to actually send.
# Leave blank otherwise; digests still write to /app/data/digests/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
