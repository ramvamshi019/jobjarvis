{
  "manifest_version": 3,
  "name": "JobJarvis Save",
  "version": "1.0.0",
  "description": "Save any job posting to your JobJarvis index. Detects Greenhouse, Lever, Ashby, Workable, and more.",

  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],

  "action": {
    "default_title": "Save this job to JobJarvis",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  }
}
