# ─────────────────────────────────────────────────────────────────────────────
#  JobJarvis – Environment Variables
#  Copy this file to .env and fill in all required values.
#  Lines marked [REQUIRED] must be set before the application will start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Security ──────────────────────────────────────────────────────────────────
# [REQUIRED] Generate with: openssl rand -hex 32
SECRET_KEY=changeme_replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
# [REQUIRED] asyncpg DSN
DATABASE_URL=postgresql+asyncpg://jobjarvis:jobjarvis@localhost:5432/jobjarvis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# RedBeat scheduler (celery beat)
REDBEAT_REDIS_URL=redis://localhost:6379/3

# ── AI Providers ──────────────────────────────────────────────────────────────
# At least one is required for AI features (LLM calls)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Daily spend cap in USD – AI calls are gated when this is exceeded
AI_DAILY_BUDGET_USD=5.0

# Embedding model (OpenAI text-embedding-3-small recommended)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the backend API as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Rate Limiting (per domain) ────────────────────────────────────────────────
# Requests per second each domain bucket refills at
RATE_LIMIT_RPS=1.0
# Maximum burst tokens per domain bucket
RATE_LIMIT_BURST=5

# ── Scan Settings ─────────────────────────────────────────────────────────────
# Maximum concurrent HTTP connections per connector fetch
CONNECTOR_MAX_CONNECTIONS=10
# Request timeout in seconds
CONNECTOR_TIMEOUT_SECONDS=30
# Maximum retries before marking a company scan as failed
CONNECTOR_MAX_RETRIES=3

# ── Compliance ────────────────────────────────────────────────────────────────
# Comma-separated list of domains to never scrape
DOMAIN_BLOCKLIST=example-blocked.com,do-not-crawl.io
# Set to true to honour robots.txt (recommended in production)
RESPECT_ROBOTS_TXT=true

# ── Notifications (optional) ─────────────────────────────────────────────────
# SMTP settings for email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_FROM_EMAIL=noreply@jobjarvis.local

# ── Sentry (optional error tracking) ─────────────────────────────────────────
SENTRY_DSN=

# ── AWS S3 (optional resume storage) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=jobjarvis-resumes
